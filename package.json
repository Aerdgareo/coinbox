{
  "name": "coinbox",
  "version": "1.0.5",
  "private": true,
  "description": "攒钱盲盒 - 每天开一次，为想要的东西攒钱",
  "author": "CoinBox",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "set VITE_DEV_SERVER_URL=http://localhost:5173&& electron .",
    "dist:dir": "vite build && electron-builder --win --x64 --dir",
    "dist:inno": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-win.ps1 -Target inno",
    "dist:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-win.ps1 -Target portable",
    "dist:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-win.ps1 -Target all",
    "android:sync": "vite build && cap sync android"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "electron": "31.7.7",
    "electron-builder": "^24.13.3",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "app.coinbox.lottery",
    "productName": "CoinBox",
    "copyright": "CoinBox",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!**/*.map"
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "CoinBox-${version}-x64-Portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "artifactName": "CoinBox-${version}-x64-Setup.${ext}"
    }
  },
  "license": "GPL-3.0-or-later"
}
